# ==============================================================================
# Dragoon’s Gate — Environment Variables
# ==============================================================================

# Application Canonical URL & Domain (used to validate EIP-4361 SIWE origin and domain)
# In development, defaults to http://localhost:3000 and localhost:3000 if omitted.
# In production, these MUST be set to your canonical domain to prevent origin/domain mismatch.
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
APP_DOMAIN=localhost:3000

# Shared Redis Storage (REQUIRED in production)
# When running in production (NODE_ENV=production), Dragoon's Gate fails closed
# immediately if REDIS_URL is not set, preventing process-local memory fallback.
# In development or testing, omitting REDIS_URL safely activates the process-local adapter.
# REDIS_URL=redis://default:password@localhost:6379
